# Proveedor de LLM por defecto: usa Google Gemini vía Google AI Studio
# (nivel gratuito, no requiere tarjeta de crédito). NO activar facturación
# en el proyecto de Google Cloud asociado a esta key: eso elimina el free tier.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=

# Modelo Gemini a usar (clasificador y generador comparten el mismo).
# gemini-3.6-flash explícito (el que Google recomienda para keys nuevas;
# gemini-2.5-flash da 404 "no longer available to new users"). Free tier:
# 5 requests/minuto — se agota fácil en ráfagas, ver manejo de 429 en
# llm/client.py y la limitación documentada en docs/arquitectura.md.
GEMINI_MODEL=gemini-3.6-flash

# --- Proveedores alternativos (opcionales, para cuando haya créditos) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# LLM_PROVIDER=openai
# OPENAI_API_KEY=

# Rutas de índices persistentes de Chroma
CHROMA_PERSIST_DIR=data/processed/chroma
